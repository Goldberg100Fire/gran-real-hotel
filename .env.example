# === Firestore (obligatorio en producción) ===
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Pega el valor private_key del JSON de service account (entre comillas).
# No dejes una clave real en este archivo de ejemplo.
FIREBASE_PRIVATE_KEY=

# === Sesión / roles ===
ADMIN_SESSION_SECRET=genera_una_clave_larga_de_al_menos_32_caracteres
# Correos del jefe/dueño (acceso total). Separados por coma.
ADMIN_ALLOWED_EMAILS=dueno@hotel.com
# Opcional alias: ADMIN_OWNER_EMAILS=
# Empleados se autorizan desde el panel Admin → Personal (no van en secretos).

# === Login Google (opcional pero recomendado) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://127.0.0.1:3451

# === Correo (Resend) ===
RESEND_API_KEY=
MAIL_FROM="Gran Real Hotel <onboarding@resend.dev>"

# === Pagos PagoEfectivo (código CIP único) — cuenta del dueño ===
PAGOEFECTIVO_ACCESS_KEY=
PAGOEFECTIVO_SECRET_KEY=
PAGOEFECTIVO_ID_SERVICE=
PAGOEFECTIVO_ENV=sandbox
# Opcional: firma de notificaciones
PAGOEFECTIVO_WEBHOOK_SECRET=
